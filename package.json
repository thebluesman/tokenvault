{
  "name": "tokenvault",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: design tokens as versioned DTCG-compatible JSON, synced with GitHub, applied to Variables/Styles, exported via Style Dictionary.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "build:tokens": "node scripts/export.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.export.json",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.99.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.25.0",
    "style-dictionary": "^5.5.2",
    "typescript": "^5.7.2"
  }
}
