{
  "tv": {
    "global": {
      "motion": {
        "duration-fast": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "ALL_SCOPES"
                ],
                "variableId": "VariableID:1:12"
              },
              "subtype": "duration",
              "subtypeSource": "user"
            }
          },
          "$type": "number",
          "$value": 150
        },
        "ease-out": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "ALL_SCOPES"
                ],
                "variableId": "VariableID:1:13"
              },
              "subtype": "easing",
              "subtypeSource": "user"
            }
          },
          "$type": "string",
          "$value": "cubic-bezier(0, 0, 0.2, 1)"
        }
      },
      "opacity": {
        "disabled": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "OPACITY"
                ],
                "variableId": "VariableID:1:11"
              },
              "subtype": "opacity",
              "subtypeSource": "auto"
            }
          },
          "$type": "number",
          "$value": 0.4
        }
      },
      "radius": {
        "sm": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "CORNER_RADIUS"
                ],
                "variableId": "VariableID:1:9"
              },
              "subtype": "radius",
              "subtypeSource": "auto"
            }
          },
          "$type": "number",
          "$value": 6
        }
      },
      "size": {
        "icon": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "WIDTH_HEIGHT"
                ],
                "variableId": "VariableID:1:10"
              },
              "subtype": "sizing",
              "subtypeSource": "auto"
            }
          },
          "$type": "number",
          "$value": 24
        }
      },
      "space": {
        "4": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "GAP"
                ],
                "variableId": "VariableID:1:7"
              },
              "subtype": "spacing",
              "subtypeSource": "auto"
            }
          },
          "$type": "number",
          "$value": 4
        },
        "base": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "ALL_SCOPES"
                ],
                "variableId": "VariableID:1:8"
              },
              "subtype": "spacing",
              "subtypeSource": "default"
            }
          },
          "$type": "number",
          "$value": 8
        }
      }
    },
    "ref": {
      "palette": {
        "blue-500": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "ALL_FILLS"
                ],
                "variableId": "VariableID:1:3"
              }
            }
          },
          "$type": "color",
          "$value": "#2d7ff9"
        },
        "grey-900": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "ALL_FILLS"
                ],
                "variableId": "VariableID:1:5"
              }
            }
          },
          "$type": "color",
          "$value": "#1a1a1a"
        },
        "overlay": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "FRAME_FILL"
                ],
                "variableId": "VariableID:1:6"
              }
            }
          },
          "$type": "color",
          "$value": "#00000066"
        },
        "white": {
          "$extensions": {
            "com.tokenvault": {
              "figma": {
                "collectionId": "VariableCollectionId:1:2",
                "modeId": "1:0",
                "scopes": [
                  "ALL_FILLS"
                ],
                "variableId": "VariableID:1:4"
              }
            }
          },
          "$type": "color",
          "$value": "#ffffff"
        }
      }
    }
  }
}
